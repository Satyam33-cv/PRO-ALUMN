rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || (isAuthenticated() && request.resource.data.id == userId);
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Forms / Surveys
    match /forms/{formId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Email logs
    match /emails/{emailId} {
      allow read: if isAuthenticated() && (resource.data.senderId == request.auth.uid || resource.data.senderEmail == request.auth.token.email);
      allow write: if isAuthenticated();
    }

    // Docs
    match /docs/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Calendar events
    match /calendar_events/{eventId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Keep Notes
    match /notes/{noteId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
