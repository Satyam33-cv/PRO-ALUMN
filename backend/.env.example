# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://user:password@host:5432/postgres?sslmode=require"

# Supabase Credentials
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# JWT
JWT_SECRET="your-64-character-hex-jwt-secret"

# Server
PORT=4000
NODE_ENV=development
WEB_URL="http://localhost:3000"

# Verification Mode: "free" (OTP/college domain/ID upload) | "paid" (Razorpay fee)
VERIFICATION_MODE="free"

# Razorpay (Required if VERIFICATION_MODE="paid")
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_key_secret"

# Seed & Admin
ADMIN_EMAIL="admin@college.edu"
ADMIN_PASSWORD="Admin@12345"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI Matching
GEMINI_API_KEY=""

# Communications
SENDGRID_API_KEY=""
EMAIL_FROM="PRO ALUMN <no-reply@yourdomain.com>"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
